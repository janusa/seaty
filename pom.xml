<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.janusa</groupId>
    <artifactId>seaty</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>seaty</name>
    <description>seaty</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <kotlin.version>2.4.0</kotlin.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <!-- Mockito arrives transitively through this starter (via spring-boot-starter-test)
                 and is Spring's default mocking engine. This project mocks exclusively with MockK,
                 so we evict Mockito. Two reasons: (1) it drops jars we never use; (2) Spring's
                 MockitoTestExecutionListener otherwise eagerly initialises Mockito on the first
                 test context, which dynamically self-attaches a ByteBuddy agent and prints a JDK
                 startup warning. -->
            <exclusions>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.mockito</groupId>
                    <artifactId>mockito-junit-jupiter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.mockk</groupId>
            <artifactId>mockk-jvm</artifactId>
            <version>1.14.6</version>
            <scope>test</scope>
        </dependency>
        <!-- MockK creates mocks using a ByteBuddy agent, which by default it attaches to the
             running JVM dynamically. Modern JDKs warn about dynamic agent loading and will forbid
             it in a future release. We already get this jar transitively (via mockk-agent-jvm);
             declaring it explicitly here (version managed by the Boot BOM) lets the Surefire
             plugin below resolve its path and load it up-front with -javaagent, so MockK finds an
             already-attached agent and never self-attaches. -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- HTML parser for asserting on the served static pages (structure, links). Not managed
             by the Boot BOM, so the version is pinned here. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
            <scope>test</scope>
        </dependency>
        <!-- Architecture tests: express the Controller -> Repository layering as
             plain JUnit5 tests. ArchUnit analyses compiled bytecode, so it is language-agnostic
             (the Kotlin/K2 version is irrelevant) and needs no Maven plugin - the @ArchTest classes
             run in the normal test phase under Surefire. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>${project.basedir}/src/test/resources</directory>
            </testResource>
            <!-- Expose the canonical schema/seed SQL on the test classpath (single source of
                 truth) so tests can build a temp SQLite DB via ClassPathResource("db/..."). -->
            <testResource>
                <directory>${project.basedir}/db</directory>
                <targetPath>db</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Build-hygiene gate. The 'enforce' goal binds to the 'validate' phase (runs first on
                 every build) and FAILS the build if an invariant is violated. The rules pin this
                 project's deliberately bleeding-edge toolchain so a contributor - or future us -
                 cannot silently build on an older JDK/Maven and get different behaviour:
                   * requireJavaVersion [25,26) - this project compiles to and depends on Java 25.
                   * requireMavenVersion [3.9.16,) - the version the ./mvnw wrapper ships.
                   * banDuplicatePomDependencyVersions - catches a dependency declared twice. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.16,)</version>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The 'properties' goal (bound to the 'initialize' phase) defines one Maven property
                 per resolved dependency, named "groupId:artifactId:type", whose value is that
                 artifact's absolute path in the local repo. We use it solely to obtain
                 ${net.bytebuddy:byte-buddy-agent:jar} for the -javaagent argument below, so the
                 path and version never have to be hardcoded. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                    <!-- Emit the project's compile classpath (dependency jars, path-separated) into the
                         ${detekt.classpath} property so detekt can run in full type-resolution mode.
                         Bound to process-classes so it is set before the detekt gate runs in 'verify'.
                         For a standalone detekt run the phase must be included, e.g.
                         `./mvnw process-classes antrun:run@detekt`. -->
                    <execution>
                        <id>detekt-classpath</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputProperty>detekt.classpath</outputProperty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The forked test JVM runs with the args in argLine below. Each one silences a
                 specific JDK 25 startup warning while keeping MockK fully working; the result is a
                 clean, warning-free test run. All four use JDK 24+ syntax, which is fine because
                 this project targets Java 25. argLine cannot hold inline comments, so the per-flag
                 rationale is documented here:
                   * -javaagent:(byte-buddy-agent jar) - loads MockK's ByteBuddy agent at JVM
                     startup so MockK does not attach it dynamically (the JDK warns about, and will
                     eventually forbid, dynamic agent loading). Path comes from the property set by
                     the maven-dependency-plugin above.
                   * -Xshare:off - disables class-data sharing. CDS prints a warning when an agent
                     appends to the bootstrap classpath, which the agent above does.
                   * enable-native-access=ALL-UNNAMED - sqlite-jdbc loads its native library via
                     System.load(); granting native access suppresses the JDK's native-access
                     warning for the unnamed module.
                   * sun-misc-unsafe-memory-access=allow - ByteBuddy probes the deprecated
                     sun.misc.Unsafe.objectFieldOffset; this permits the call without its
                     "terminally deprecated" warning. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-javaagent:${net.bytebuddy:byte-buddy-agent:jar} -Xshare:off
                        --enable-native-access=ALL-UNNAMED --sun-misc-unsafe-memory-access=allow
                    </argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-Xannotation-default-target=param-property</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!-- Kotlin formatter. Spotless drives the ktlint engine (pinned, so engine upgrades are
                 deliberate) against the project's .editorconfig. The 'check' goal binds to 'verify'
                 and FAILS the build on any formatting drift; run `./mvnw spotless:apply` locally to
                 auto-fix. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <kotlin>
                        <ktlint>
                            <version>1.8.0</version>
                        </ktlint>
                    </kotlin>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- detekt static analysis gate. detekt ships NO Maven plugin, so we run its CLI
                 (dev.detekt.cli.Main) the way the detekt docs prescribe: an Ant <java> task launched by
                 maven-antrun-plugin, bound to 'verify' (alongside Spotless). Key attributes:
                   * fork="true" - runs detekt in a SEPARATE JVM. detekt-cli bundles kotlin-compiler, so
                     running it inside Maven's own JVM risks classloader clashes; forking isolates it.
                   * failonerror="true" - a non-zero CLI exit (detekt found issues at/above the fail
                     severity) FAILS the build, matching the Spotless/Enforcer/ArchUnit gates.
                   * classpathref="maven.plugin.classpath" - the detekt-cli dependency declared below;
                     Maven resolves its full transitive closure automatically (no manual -Xplugin path).
                 Pinned to detekt 2.0.0-alpha.5 - the only line that parses Kotlin 2.4 - so the upgrade is
                 deliberate (there is no RC yet). We deliberately do NOT add detekt-rules-ktlint-wrapper:
                 that ruleset would duplicate the Spotless+ktlint formatting gate.
                 Runs with all rules active (the "all-rules" arg) and full type resolution (the
                 "analysis-mode full" arg, fed by the ${detekt.classpath} property built above), so
                 type-aware rules like ForbiddenVoid actually run. Opinionated/overlapping rules are
                 tuned off in detekt.yml. Run standalone with `./mvnw process-classes antrun:run@detekt`
                 (the phase populates the classpath property). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>detekt</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target name="detekt">
                                <java taskname="detekt" dir="${project.basedir}"
                                      fork="true"
                                      failonerror="true"
                                      classname="dev.detekt.cli.Main"
                                      classpathref="maven.plugin.classpath">
                                    <!-- kotlin-compiler (via com.intellij ...Unsafe) probes the
                                         terminally-deprecated sun.misc.Unsafe.objectFieldOffset; allow it
                                         so the forked JVM stays warning-free, mirroring the Surefire
                                         argLine above. -->
                                    <jvmarg value="--sun-misc-unsafe-memory-access=allow"/>
                                    <arg value="--input"/>
                                    <arg value="${project.basedir}/src/main/kotlin"/>
                                    <arg value="--config"/>
                                    <arg value="${project.basedir}/detekt.yml"/>
                                    <arg value="--build-upon-default-config"/>
                                    <!-- Maximum strictness: activate every rule (incl. those off by
                                         default) and run with full type resolution so type-aware rules
                                         (ForbiddenVoid, SpreadOperator, many potential-bugs) actually run.
                                         Noise from opinionated rules is tuned off in detekt.yml. The
                                         classpath comes from the build-classpath execution above. -->
                                    <arg value="--all-rules"/>
                                    <arg value="--analysis-mode"/>
                                    <arg value="full"/>
                                    <arg value="--classpath"/>
                                    <arg value="${detekt.classpath}"/>
                                    <!-- detekt 2.0 report ids: sarif|html|markdown|checkstyle (there is
                                         no 'xml' id). sarif = machine-readable for CI ingestion,
                                         html = human-readable. -->
                                    <arg value="--report"/>
                                    <arg value="sarif:${project.build.directory}/detekt/detekt.sarif"/>
                                    <arg value="--report"/>
                                    <arg value="html:${project.build.directory}/detekt/detekt.html"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>dev.detekt</groupId>
                        <artifactId>detekt-cli</artifactId>
                        <version>2.0.0-alpha.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
